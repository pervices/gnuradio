Subject: [PATCH 49/80] GH CI/conda: migrate rerender action to
 setup-micromamba
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Marcus Müller <mmueller@gnuradio.org>
---
 .github/workflows/conda-rerender-ci.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/conda-rerender-ci.yml b/.github/workflows/conda-rerender-ci.yml
index d38c334d3b..271098e369 100644
--- a/.github/workflows/conda-rerender-ci.yml
+++ b/.github/workflows/conda-rerender-ci.yml
@@ -42,7 +42,7 @@ jobs:
             dependencies:
               - conda-smithy
       - name: Install conda-smithy
-        uses: mamba-org/provision-with-micromamba@main
+        uses: mamba-org/setup-micromamba@v2
         with:
           environment-file: rerender-env.yml
       - name: Re-render
